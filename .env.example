# OpenAI를 사용하려면 API 키를 채워 넣으세요. 비워두면 로컬 Ollama로 자동 Fallback됩니다.
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-5.6-luna
OPENAI_TEMPERATURE=0.0

# false로 설정하면 OPENAI_API_KEY가 있어도 무조건 로컬 Ollama만 사용합니다.
USE_OPENAI=true

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5-coder:7b
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
